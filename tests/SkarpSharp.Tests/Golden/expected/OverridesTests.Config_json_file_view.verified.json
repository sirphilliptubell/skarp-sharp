{
  "overrides": [
    {
      "index": 0,
      "files": [
        "src/Legacy/**"
      ],
      "excludeFiles": [
        "src/Legacy/Keep/**"
      ],
      "rules": {
        "magic-number": true
      },
      "thresholds": {
        "long-method": {
          "notice": 100
        }
      },
      "matched": 1
    },
    {
      "index": 1,
      "files": [
        "**/*.Gen.cs"
      ],
      "rules": {
        "long-method": false,
        "complex-method": false
      },
      "matched": 1
    },
    {
      "index": 2,
      "tests": true,
      "thresholds": {
        "complex-method": {
          "notice": 25
        }
      },
      "matched": 0
    },
    {
      "index": 3,
      "files": [
        "tools/**"
      ],
      "rules": {
        "empty-catch": false
      },
      "matched": 0
    }
  ],
  "file": {
    "path": "src/New.cs",
    "testCode": false,
    "overrides": [],
    "rules": [
      {
        "rule": "complex-method",
        "part": "notice",
        "value": "cognitive over 15",
